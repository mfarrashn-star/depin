// Draf kebijakan ACL tailnet untuk kluster compute.
// Tidak mengandung rahasia. Belum diterapkan otomatis: auth key node tidak bisa
// menulis ACL. Terapkan di https://login.tailscale.com/admin/acls
//
// Langkah:
// 1. Buka Access Controls, salin kebijakan lama ke cadangan.
// 2. Tempel berkas ini, lalu Save.
// 3. Baru setelah Save, pasang tag di halaman Machines:
//      - komputerbox10 dan node compute berikutnya: tag:compute
//      - VPS Windows: tag:vps
//    Perangkat owner (HP, laptop) tetap tanpa tag.
//    Jangan menag ulang grokbot-box kecuali owner meminta secara eksplisit.
// 4. Node baru gabung lewat /workspace/compute/node-bootstrap/ plus reusable
//    auth key yang sudah membawa tag:compute.
//
// Funnel tetap mati: berkas ini tidak memasang atribut "funnel".
// VPS Windows tidak menjadi server Tailscale SSH; owner dan agen masuk lewat TCP 22
// (OpenSSH) atau 3389 (RDP, hanya owner).
//
// Setelah perangkat di-tag, identitas user-nya hilang. Jangan menag komputerbox10
// sebelum kebijakan ini tersimpan, atau SSH dari box ke VPS bisa putus.
//
// Port antrean job, heartbeat, dan dashboard node di VPS akan ditambahkan ke
// grant tag:compute -> tag:vps saat layanan itu berdiri. Jangan membuka port
// itu ke internet.

{
  "tagOwners": {
    // Hanya owner tailnet yang boleh memasang tag ini (admin selalu bisa).
    "tag:compute": ["m.farras.hn@gmail.com"],
    "tag:vps":     ["m.farras.hn@gmail.com"],
  },

  "grants": [
    // Perangkat owner (tanpa tag) tetap akses penuh, supaya menerapkan
    // kebijakan ini tidak mengunci owner saat node masih dalam proses penag-an.
    // Bisa diperketat nanti setelah tailnet bertambah besar.
    {
      "src": ["m.farras.hn@gmail.com"],
      "dst": ["*"],
      "ip":  ["*"],
    },

    // Port Ray antar node compute. Owner tetap bisa masuk lewat grant di atas.
    {
      "src": ["tag:compute"],
      "dst": ["tag:compute"],
      "ip": [
        "tcp:6379-6381",
        "tcp:8265",
        "tcp:10001",
        "tcp:10002-10200",
        "tcp:52365",
        "tcp:8090",
      ],
    },

    // Agen di komputerbox perlu SSH ke VPS (OpenSSH). RDP tetap hanya owner.
    // Tambahkan port antrean / heartbeat / dashboard di sini nanti.
    {
      "src": ["tag:compute"],
      "dst": ["tag:vps"],
      "ip":  ["tcp:22"],
    },

    // SSH dan RDP owner ke VPS. Redundan dengan grant pertama hari ini,
    // tetapi tetap berguna jika grant itu nanti dipersempit. Perangkat
    // ber-tag tidak mewarisi identitas owner.
    {
      "src": ["m.farras.hn@gmail.com"],
      "dst": ["tag:vps"],
      "ip":  ["tcp:22", "tcp:3389"],
    },
  ],

  "tests": [
    {
      "src":    "tag:compute",
      "accept": [
        "tag:compute:6379",
        "tag:compute:6380",
        "tag:compute:6381",
        "tag:compute:8265",
        "tag:compute:10001",
        "tag:compute:10002",
        "tag:compute:10200",
        "tag:compute:52365",
        "tag:compute:8090",
        "tag:vps:22",
      ],
    },
    {
      "src":    "m.farras.hn@gmail.com",
      "accept": [
        "tag:compute:6379",
        "tag:compute:10001",
        "tag:vps:22",
        "tag:vps:3389",
      ],
    },
    // Node compute tidak perlu RDP ke VPS.
    {
      "src":  "tag:compute",
      "deny": ["tag:vps:3389"],
    },
  ],
}
